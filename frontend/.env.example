# Supabase project (public values only — the service role key must NEVER
# appear anywhere under frontend/).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Backend API origin. Leave unset for a same-domain deploy (or the dev proxy),
# which uses "/api". Set to the Django backend URL (including /api) when the
# API is hosted on a different domain, e.g. a separate Vercel project:
#   VITE_API_BASE_URL=https://<your-backend>.vercel.app/api
#
# iOS アプリ（Capacitor）では必須。アプリは capacitor://localhost から動くので、
# 相対パスの "/api" だと自分自身のバンドルを叩いて必ず失敗する。
# frontend/.env.production に https:// の絶対 URL を書く（手順は docs/ios.md）。
VITE_API_BASE_URL=

# Feature flags. Student-ID verification/upload is OFF until a private
# Supabase Storage bucket is provisioned; set to "true" to enable it.
VITE_FEATURE_STUDENT_VERIFICATION=
