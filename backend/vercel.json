{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [{ "src": "api/index.py", "use": "@vercel/python" }],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }],
  "regions": ["icn1"],
  "crons": [
    { "path": "/api/internal/aggregate/", "schedule": "5 * * * *" },
    { "path": "/api/internal/advance-grades/", "schedule": "10 15 31 3 *" }
  ]
}
