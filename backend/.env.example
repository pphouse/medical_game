# --- Django -----------------------------------------------------------------
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (Supabase Postgres) --------------------------------------------
# Runtime: transaction-mode pooler (port 6543). conn_max_age is forced to 0.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations: direct connection (port 5432); used via config.settings_migration:
#   python manage.py migrate --settings=config.settings_migration
MIGRATION_DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Local development without Supabase: a plain Postgres works for both, e.g.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/medical_game

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Service role key: BACKEND ONLY. Never put this in frontend/.env*.
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard > Project Settings > API > JWT Secret (legacy HS256 secret)
SUPABASE_JWT_SECRET=

# --- Internal / scheduled jobs ------------------------------------------------
# Shared secret for /api/internal/* (called from the Supabase Edge Function).
INTERNAL_API_TOKEN=

# --- Web Push (review reminders) ----------------------------------------------
# Generate a VAPID key pair: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# --- Question generation scripts ----------------------------------------------
ANTHROPIC_API_KEY=
